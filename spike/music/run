#!/bin/sh
# Usage: run <script> [args...]
# Concatenates lib.js and <script>.js and runs it with osascript, passing the
# remaining arguments as argv. The Go client (task 7.1) does the same thing
# with embedded sources.
set -eu
dir=$(cd "$(dirname "$0")" && pwd)
name=$1
shift
exec osascript -l JavaScript -e "$(cat "$dir/lib.js" "$dir/$name.js")" "$@"
