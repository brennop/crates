#!/bin/sh
# Usage: run <script> [args...]
# Concatenates lib.js and <script>.js and runs it with osascript, passing the
# remaining arguments as argv: the same thing the Go client does with the
# embedded sources. For manual checks against the real library.
set -eu
dir=$(cd "$(dirname "$0")" && pwd)
name=$1
shift
exec osascript -l JavaScript -e "$(cat "$dir/lib.js" "$dir/$name.js")" "$@"
